# Copy this file to .env and adjust the values. Never commit .env.

# Database
POSTGRES_DB=cooperar
POSTGRES_USER=cooperar
POSTGRES_PASSWORD=cooperar

# Backend
# Profiles: dev (Swagger UI, readable logs) | prod (structured ECS logs, no API docs)
SPRING_PROFILES_ACTIVE=dev
# HS256 key used to sign JWTs, at least 32 characters. Mandatory and random in prod,
# e.g. openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Initial admin account, created at startup only if no admin exists yet. Mandatory in prod
# (without them nobody can sign in as admin); the dev profile falls back to admin@cooperar.local.
ADMIN_EMAIL=admin@cooperar.local
ADMIN_PASSWORD=dev-admin-password
# Optional name of that admin, shown in the observatory panel (the email is shown otherwise).
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Observatorio

# Email (SMTP). Any server works: the Faculty's or a self-hosted one. MAIL_HOST, MAIL_FROM and PUBLIC_URL are
# mandatory in prod. docker compose points the backend at Mailpit (http://localhost:8025), which catches every email.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
# Both default to true outside the dev profile.
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=CooperAR <no-reply@cooperar.local>
# Where people open the frontend; the links in the emails (e.g. to confirm the account) point here.
PUBLIC_URL=http://localhost:5173

# Geocoding of the organizations' addresses: nominatim or none (the organization then places the pin by hand).
# The public Nominatim instance allows at most one request per second; point NOMINATIM_URL at a self-hosted one if
# that is not enough.
GEOCODING_PROVIDER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Suggestions for the address fields (districts, localities and streets): georef or none (typed by hand). The public
# GeoRef API has an anonymous quota shared by every client; point GEOREF_URL at a self-hosted one if that is not
# enough. Districts and localities are cached in memory for GEOGRAPHY_CACHE_TTL; streets are never cached.
GEOGRAPHY_PROVIDER=georef
GEOREF_URL=https://apis.datos.gob.ar/georef/api
GEOGRAPHY_CACHE_TTL=7d

# Photos of the products: disk (a directory of the server; a Docker volume with docker compose) or cloud (a cloud service, today Cloudinary; the
# public demo, whose host loses its disk on every deploy). The cloud also needs the three variables below.
IMAGE_STORAGE=disk
IMAGE_CLOUD_NAME=
IMAGE_CLOUD_API_KEY=
IMAGE_CLOUD_API_SECRET=

# Ports published on the host
DB_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173
MAILPIT_PORT=8025
# Optional: a real SMTP server Mailpit uses when a message is released by hand ("Release"), to receive it in a real
# inbox. Empty: Mailpit keeps everything. The sender must be one the server accepts (with Brevo, a verified one).
MAILPIT_RELAY_HOST=
MAILPIT_RELAY_PORT=587
MAILPIT_RELAY_USERNAME=
MAILPIT_RELAY_PASSWORD=
MAILPIT_RELAY_FROM=

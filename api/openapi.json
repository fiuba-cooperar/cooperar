{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Open observatory of worker-recovered companies and worker cooperatives",
    "title" : "CooperAR API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/api/auth/login" : {
      "post" : {
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Sign in with email and password",
        "tags" : [ "auth" ]
      }
    },
    "/api/auth/logout" : {
      "post" : {
        "operationId" : "logout",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshTokenRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        },
        "summary" : "Revoke a refresh token",
        "tags" : [ "auth" ]
      }
    },
    "/api/auth/refresh" : {
      "post" : {
        "operationId" : "refreshSession",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshTokenRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Exchange a refresh token for a new token pair",
        "tags" : [ "auth" ]
      }
    },
    "/api/auth/register" : {
      "post" : {
        "description" : "Answers 409 with a `conflicts` list (`EMAIL`, `CUIT`) when either is already registered.",
        "operationId" : "register",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RegistrationRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RegistrationResponse"
                }
              }
            },
            "description" : "Created"
          }
        },
        "summary" : "Create an account together with its first organization",
        "tags" : [ "auth" ]
      }
    },
    "/api/health" : {
      "get" : {
        "operationId" : "getHealth",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/HealthResponse"
                }
              }
            },
            "description" : "The application and its database are up"
          },
          "503" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/HealthResponse"
                }
              }
            },
            "description" : "A dependency is down"
          }
        },
        "summary" : "Application and database health",
        "tags" : [ "health" ]
      }
    },
    "/api/me" : {
      "get" : {
        "operationId" : "getCurrentUser",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CurrentUserResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "The signed-in account, its role and its organizations",
        "tags" : [ "auth" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "CurrentUserResponse" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string"
          },
          "firstName" : {
            "type" : "string",
            "description" : "Missing for the initial admin when it was created without a name"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "lastName" : {
            "type" : "string",
            "description" : "Missing for the initial admin when it was created without a name"
          },
          "organizations" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/OrganizationSummary"
            }
          },
          "role" : {
            "$ref" : "#/components/schemas/Role"
          }
        },
        "required" : [ "email", "id", "organizations", "role" ]
      },
      "HealthResponse" : {
        "type" : "object",
        "description" : "Application health and the state of its dependencies",
        "properties" : {
          "database" : {
            "$ref" : "#/components/schemas/HealthStatus"
          },
          "status" : {
            "$ref" : "#/components/schemas/HealthStatus"
          }
        },
        "required" : [ "database", "status" ]
      },
      "HealthStatus" : {
        "type" : "string",
        "enum" : [ "UP", "DOWN" ]
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "minLength" : 1
          },
          "password" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "email", "password" ]
      },
      "OrganizationSummary" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "name" ]
      },
      "OrganizationType" : {
        "type" : "string",
        "enum" : [ "COOPERATIVE", "ERT", "COOPERATIVE_AND_ERT" ]
      },
      "Province" : {
        "type" : "string",
        "enum" : [ "BUENOS_AIRES", "CITY_OF_BUENOS_AIRES", "CATAMARCA", "CHACO", "CHUBUT", "CORDOBA", "CORRIENTES", "ENTRE_RIOS", "FORMOSA", "JUJUY", "LA_PAMPA", "LA_RIOJA", "MENDOZA", "MISIONES", "NEUQUEN", "RIO_NEGRO", "SALTA", "SAN_JUAN", "SAN_LUIS", "SANTA_CRUZ", "SANTA_FE", "SANTIAGO_DEL_ESTERO", "TIERRA_DEL_FUEGO", "TUCUMAN" ]
      },
      "RefreshTokenRequest" : {
        "type" : "object",
        "properties" : {
          "refreshToken" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "refreshToken" ]
      },
      "RegistrationAccountRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          },
          "firstName" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "lastName" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "format" : "password",
            "maxLength" : 72,
            "minLength" : 8
          }
        },
        "required" : [ "email", "firstName", "lastName", "password" ]
      },
      "RegistrationAddressRequest" : {
        "type" : "object",
        "properties" : {
          "additionalReferences" : {
            "type" : "string",
            "maxLength" : 300,
            "minLength" : 0
          },
          "district" : {
            "type" : "string",
            "description" : "Departamento, partido or comuna",
            "maxLength" : 100,
            "minLength" : 0
          },
          "locality" : {
            "type" : "string",
            "description" : "Locality or neighborhood",
            "maxLength" : 100,
            "minLength" : 0
          },
          "province" : {
            "$ref" : "#/components/schemas/Province"
          },
          "street" : {
            "type" : "string",
            "description" : "Street and number",
            "maxLength" : 200,
            "minLength" : 0
          }
        },
        "required" : [ "district", "locality", "province", "street" ]
      },
      "RegistrationOrganizationRequest" : {
        "type" : "object",
        "properties" : {
          "address" : {
            "$ref" : "#/components/schemas/RegistrationAddressRequest"
          },
          "cuit" : {
            "type" : "string",
            "description" : "With or without dashes; the check digit is validated",
            "example" : "30-12345678-1",
            "minLength" : 1
          },
          "name" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          },
          "sector" : {
            "$ref" : "#/components/schemas/Sector"
          },
          "type" : {
            "$ref" : "#/components/schemas/OrganizationType"
          }
        },
        "required" : [ "address", "cuit", "name", "sector", "type" ]
      },
      "RegistrationRequest" : {
        "type" : "object",
        "properties" : {
          "account" : {
            "$ref" : "#/components/schemas/RegistrationAccountRequest"
          },
          "organization" : {
            "$ref" : "#/components/schemas/RegistrationOrganizationRequest"
          }
        },
        "required" : [ "account", "organization" ]
      },
      "RegistrationResponse" : {
        "type" : "object",
        "properties" : {
          "accountId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "organizationId" : {
            "type" : "string",
            "format" : "uuid"
          }
        },
        "required" : [ "accountId", "organizationId" ]
      },
      "Role" : {
        "type" : "string",
        "enum" : [ "ADMIN", "COOPERATIVE" ]
      },
      "Sector" : {
        "type" : "string",
        "enum" : [ "FOOD", "TEXTILE", "METALWORKING", "PRINTING", "SERVICES", "OTHER" ]
      },
      "TokenResponse" : {
        "type" : "object",
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "expiresIn" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Seconds until the access token expires"
          },
          "refreshToken" : {
            "type" : "string"
          }
        },
        "required" : [ "accessToken", "expiresIn", "refreshToken" ]
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  }
}

# Copy this file to .env and adjust the values. Never commit .env.

# Database
POSTGRES_DB=cooperar
POSTGRES_USER=cooperar
POSTGRES_PASSWORD=cooperar

# Backend
# Profiles: dev (Swagger UI, readable logs) | prod (structured ECS logs, no API docs)
SPRING_PROFILES_ACTIVE=dev
# HS256 key used to sign JWTs, at least 32 characters. Mandatory and random in prod,
# e.g. openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# Ports published on the host
DB_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173

{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Open observatory of worker-recovered companies and worker cooperatives",
    "title" : "CooperAR API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/api/auth/login" : {
      "post" : {
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Sign in with email and password",
        "tags" : [ "auth" ]
      }
    },
    "/api/auth/logout" : {
      "post" : {
        "operationId" : "logout",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshTokenRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        },
        "summary" : "Revoke a refresh token",
        "tags" : [ "auth" ]
      }
    },
    "/api/auth/refresh" : {
      "post" : {
        "operationId" : "refreshSession",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshTokenRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Exchange a refresh token for a new token pair",
        "tags" : [ "auth" ]
      }
    },
    "/api/cooperatives/{slug}" : {
      "get" : {
        "operationId" : "getCooperativeProfile",
        "parameters" : [ {
          "in" : "path",
          "name" : "slug",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CooperativeProfileResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Public profile of a cooperative",
        "tags" : [ "cooperatives" ]
      }
    },
    "/api/health" : {
      "get" : {
        "operationId" : "getHealth",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/HealthResponse"
                }
              }
            },
            "description" : "The application and its database are up"
          },
          "503" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/HealthResponse"
                }
              }
            },
            "description" : "A dependency is down"
          }
        },
        "summary" : "Application and database health",
        "tags" : [ "health" ]
      }
    },
    "/api/me" : {
      "get" : {
        "operationId" : "getCurrentUser",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CurrentUserResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "The signed-in account, its role and its cooperatives",
        "tags" : [ "auth" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "CooperativeProfileResponse" : {
        "type" : "object",
        "properties" : {
          "address" : {
            "type" : "string"
          },
          "description" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "industry" : {
            "type" : "string"
          },
          "locality" : {
            "type" : "string"
          },
          "location" : {
            "$ref" : "#/components/schemas/GeoPoint"
          },
          "name" : {
            "type" : "string"
          },
          "phone" : {
            "type" : "string"
          },
          "province" : {
            "type" : "string"
          },
          "slug" : {
            "type" : "string"
          }
        },
        "required" : [ "name", "slug" ]
      },
      "CooperativeSummary" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "name" ]
      },
      "CurrentUserResponse" : {
        "type" : "object",
        "properties" : {
          "cooperatives" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/CooperativeSummary"
            }
          },
          "email" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "role" : {
            "$ref" : "#/components/schemas/Role"
          }
        },
        "required" : [ "cooperatives", "email", "id", "role" ]
      },
      "GeoPoint" : {
        "type" : "object",
        "properties" : {
          "latitude" : {
            "type" : "number",
            "format" : "double"
          },
          "longitude" : {
            "type" : "number",
            "format" : "double"
          }
        },
        "required" : [ "latitude", "longitude" ]
      },
      "HealthResponse" : {
        "type" : "object",
        "description" : "Application health and the state of its dependencies",
        "properties" : {
          "database" : {
            "$ref" : "#/components/schemas/HealthStatus"
          },
          "status" : {
            "$ref" : "#/components/schemas/HealthStatus"
          }
        },
        "required" : [ "database", "status" ]
      },
      "HealthStatus" : {
        "type" : "string",
        "enum" : [ "UP", "DOWN" ]
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "minLength" : 1
          },
          "password" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "email", "password" ]
      },
      "RefreshTokenRequest" : {
        "type" : "object",
        "properties" : {
          "refreshToken" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "refreshToken" ]
      },
      "Role" : {
        "type" : "string",
        "enum" : [ "ADMIN", "COOPERATIVE" ]
      },
      "TokenResponse" : {
        "type" : "object",
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "expiresIn" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Seconds until the access token expires"
          },
          "refreshToken" : {
            "type" : "string"
          }
        },
        "required" : [ "accessToken", "expiresIn", "refreshToken" ]
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  }
}
